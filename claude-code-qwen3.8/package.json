{
  "name": "snake-app",
  "private": true,
  "version": "1.0.0",
  "description": "Neo-retro 2D 8-bit neon snake — Phaser 4 screen-space FX, procedural Tone.js lo-fi, CRT-TV shell. Pure-integer deterministic domain.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4174",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/domain-boundary.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-e2e": "playwright test",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.17.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
